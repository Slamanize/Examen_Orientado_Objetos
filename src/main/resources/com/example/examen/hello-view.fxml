<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="800.0" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.examen.Controler.Controlador">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <children>
      <Label prefHeight="39.0" prefWidth="314.0" text="ArenaGamers Software" textFill="#6f00ff">
         <VBox.margin>
            <Insets right="450.0" />
         </VBox.margin>
         <font>
            <Font name="Arial Bold" size="27.0" />
         </font>
      </Label>
      <HBox prefHeight="211.0" prefWidth="760.0">
         <VBox.margin>
            <Insets bottom="300.0" />
         </VBox.margin>
         <children>
            <GridPane prefHeight="206.0" prefWidth="510.0">
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <Label text="Datos Cliente:">
                     <GridPane.margin>
                        <Insets bottom="90.0" />
                     </GridPane.margin>
                  </Label>
                  <Label text="RUT:">
                     <GridPane.margin>
                        <Insets bottom="50.0" />
                     </GridPane.margin>
                  </Label>
                  <TextField fx:id="txtRut" promptText="Ej: 12345678">
                     <GridPane.margin>
                        <Insets bottom="47.0" left="30.0" />
                     </GridPane.margin>
                  </TextField>
                  <Label text="-" GridPane.columnIndex="1">
                     <GridPane.margin>
                        <Insets bottom="46.0" />
                     </GridPane.margin>
                  </Label>
                  <TextField fx:id="txtDv" prefHeight="25.0" prefWidth="105.0" promptText="Ej k" GridPane.columnIndex="1">
                     <GridPane.margin>
                        <Insets bottom="46.0" left="5.0" right="130.0" />
                     </GridPane.margin>
                  </TextField>
                  <Label text="Nombre:">
                     <GridPane.margin>
                        <Insets top="10.0" />
                     </GridPane.margin>
                  </Label>
                  <TextField fx:id="txtNombre" promptText="Ej: Juan">
                     <opaqueInsets>
                        <Insets />
                     </opaqueInsets>
                     <GridPane.margin>
                        <Insets left="50.0" top="10.0" />
                     </GridPane.margin>
                  </TextField>
                  <Label text="Apellido:">
                     <padding>
                        <Insets top="60.0" />
                     </padding>
                  </Label>
                  <TextField fx:id="txtApellido" promptText="eJ: Perez">
                     <opaqueInsets>
                        <Insets />
                     </opaqueInsets>
                     <GridPane.margin>
                        <Insets left="50.0" top="60.0" />
                     </GridPane.margin>
                  </TextField>
                  <Label text="Telefono:">
                     <GridPane.margin>
                        <Insets top="120.0" />
                     </GridPane.margin>
                  </Label>
                  <TextField fx:id="txtTelefono" prefHeight="25.0" prefWidth="213.0" promptText="Ej: +56 9 1234 5678" GridPane.rowIndex="1">
                     <GridPane.margin>
                        <Insets bottom="20.0" left="50.0" right="4.0" />
                     </GridPane.margin>
                  </TextField>
               </children>
            </GridPane>
         </children>
      </HBox>
   </children>
</VBox>
