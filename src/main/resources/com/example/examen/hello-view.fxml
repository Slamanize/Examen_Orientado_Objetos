                        <Insets top="70.0" />
                     </GridPane.margin>
                  </Label>
                  <TextField fx:id="txtModelo" promptText="Ej: A520MK" GridPane.rowIndex="2">
                     <GridPane.margin>
                        <Insets left="50.0" right="40.0" top="70.0" />
                     </GridPane.margin>
                  </TextField>
                  <Label text="Año Adquisicion:" GridPane.columnIndex="1" GridPane.rowIndex="2">
                     <GridPane.margin>
                        <Insets bottom="50.0" />
                     </GridPane.margin>
                  </Label>
                  <TextField fx:id="txtAnio" promptText="Ej: 2010" GridPane.columnIndex="1" GridPane.rowIndex="2">
                     <GridPane.margin>
                        <Insets bottom="50.0" left="90.0" right="80.0" />
                     </GridPane.margin>
                  </TextField>
                  <Label text="Horas de uso:" GridPane.columnIndex="1" GridPane.rowIndex="2">
                     <GridPane.margin>
                        <Insets top="10.0" />
                     </GridPane.margin>
                  </Label>
                  <TextField fx:id="txtHorasuso" promptText="EJ: 3" GridPane.columnIndex="1" GridPane.rowIndex="2">
                     <GridPane.margin>
                        <Insets left="75.0" right="100.0" top="10.0" />
                     </GridPane.margin>
                  </TextField>
                  <Label text="Horas" GridPane.columnIndex="1" GridPane.rowIndex="2">
                     <GridPane.margin>
                        <Insets left="160.0" top="10.0" />
                     </GridPane.margin>
                  </Label>
