                  </TextField>
                  <Label text="Nombre:">
                     <GridPane.margin>
                        <Insets top="10.0" />
                     </GridPane.margin>
                  </Label>
                  <TextField fx:id="txtNombre" promptText="Ej: Juan">
                     <opaqueInsets>
                        <Insets />
                     </opaqueInsets>
                     <GridPane.margin>
                        <Insets left="50.0" top="10.0" />
                     </GridPane.margin>
                  </TextField>
                  <Label text="Apellido:">
                     <padding>
                        <Insets top="60.0" />
                     </padding>
                  </Label>
                  <TextField fx:id="txtApellido" promptText="eJ: Perez">
                     <opaqueInsets>
                        <Insets />
                     </opaqueInsets>
                     <GridPane.margin>
                        <Insets left="50.0" top="60.0" />
                     </GridPane.margin>
                  </TextField>
                  <Label text="Telefono:">
                     <GridPane.margin>
                        <Insets top="120.0" />
                     </GridPane.margin>
                  </Label>
                  <TextField fx:id="txtTelefono" prefHeight="25.0" prefWidth="213.0" promptText="Ej: +56 9 1234 5678" GridPane.rowIndex="1">
