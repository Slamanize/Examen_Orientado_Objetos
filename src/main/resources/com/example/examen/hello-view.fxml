                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
                  <Label text="Memoria RAM:">
                     <GridPane.margin>
                        <Insets top="10.0" />
                     </GridPane.margin>
                  </Label>
                  <TextField fx:id="txtRam" promptText="Ej: 8">
                     <GridPane.margin>
                        <Insets left="85.0" right="80.0" top="10.0" />
                     </GridPane.margin>
                  </TextField>
                  <Label text="GB">
                     <GridPane.margin>
                        <Insets left="185.0" top="10.0" />
                     </GridPane.margin>
                  </Label>
                  <CheckBox fx:id="chkTieneGPU" mnemonicParsing="false" text="Tiene GPU" GridPane.rowIndex="1">
