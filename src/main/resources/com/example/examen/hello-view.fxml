               </columnConstraints>
               <rowConstraints>
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
               </rowConstraints>
               <children>
                  <Label text="Datos Cliente:">
                     <GridPane.margin>
                        <Insets bottom="90.0" />
                     </GridPane.margin>
                  </Label>
                  <Label text="RUT:">
                     <GridPane.margin>
                        <Insets bottom="50.0" />
                     </GridPane.margin>
                  </Label>
                  <TextField fx:id="txtRut" promptText="Ej: 12345678">
                     <GridPane.margin>
                        <Insets bottom="47.0" left="30.0" />
                     </GridPane.margin>
                  </TextField>
                  <Label text="-" GridPane.columnIndex="1">
                     <GridPane.margin>
                        <Insets bottom="46.0" />
                     </GridPane.margin>
                  </Label>
                  <TextField fx:id="txtDv" prefHeight="25.0" prefWidth="105.0" promptText="Ej k" GridPane.columnIndex="1">
