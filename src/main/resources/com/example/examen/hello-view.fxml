            </GridPane>
         </children>
      </HBox>

      <!-- SEGUNDO HBOX ABAJO -->
      <HBox alignment="CENTER_LEFT" prefHeight="140.0" prefWidth="780.0" spacing="15.0">
         <children>
            <GridPane prefHeight="130.0" prefWidth="520.0">
               <columnConstraints>
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="150.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="150.0" />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
               </rowConstraints>
               <children>
                  <Label text="PC GAMER DATOS:">
                     <GridPane.margin>
                        <Insets bottom="30.0" />
                     </GridPane.margin>
