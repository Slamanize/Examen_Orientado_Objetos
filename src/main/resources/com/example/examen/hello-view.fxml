                     </GridPane.margin>
                  </CheckBox>
                  <Label text="CONSOLA DATOS:" GridPane.rowIndex="1">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
                  <Label text="Generacion:" GridPane.rowIndex="1">
                     <GridPane.margin>
                        <Insets top="40.0" />
                     </GridPane.margin>
                  </Label>
                  <TextField fx:id="txtGen" promptText="Ej: 1-10" GridPane.rowIndex="1">
                     <GridPane.margin>
                        <Insets left="65.0" right="130.0" top="40.0" />
                     </GridPane.margin>
                  </TextField>
                  <Label text="Almacenamiento:" GridPane.rowIndex="2" />
                  <TextField fx:id="txtAlmacenamiento" promptText="Ej: 250" GridPane.rowIndex="2">
                     <GridPane.margin>
                        <Insets left="95.0" right="120.0" />
                     </GridPane.margin>
                  </TextField>
                  <Label text="GB" GridPane.rowIndex="2">
                     <GridPane.margin>
                        <Insets left="145.0" />
                     </GridPane.margin>
                  </Label>
               </children>
            </GridPane>
         </children>
      </HBox>
   </children>
</VBox>
